# Environment for the Docker self-host deployment (docker-compose.yml).
# Copy to .env and fill in the values, then: docker compose up -d

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4003

# ── CORS ─────────────────────────────────────────────────────────────────────
# The domain (or IP) you'll reach moka at. Only matters if you expose it beyond
# localhost — same-origin requests (the normal case, frontend served by this
# same container) don't need CORS at all.
ALLOWED_ORIGIN=http://localhost:4003

# ── Render authentication (optional — read this before setting it) ───────────
# Callers must send "Authorization: Bearer <token>" on every POST /api/render
# request. The bundled web UI does NOT send this header — setting it does
# nothing to protect the UI itself, and does not touch /upload, /download or
# /mediainfo either. It only stops someone from scripting direct calls against
# the render endpoint to burn your CPU. Generate one with: openssl rand -hex 32
#
# To actually restrict who can reach moka at all (UI included), put a reverse
# proxy in front (Caddy basic_auth, an IP allowlist, a VPN/Tailscale, etc.) —
# see the security note in docker-compose.yml if you expose the port directly.
RENDER_TOKEN=

# ── Resource limits (defaults tuned for a small/single-vCPU VPS) ─────────────
# Raise these if your host has more headroom. See docker-compose.yml for the
# matching container-level mem_limit/cpus.
#
# NOTE: values on these lines must NOT have trailing comments — Docker's
# env-file parser takes everything after "=" literally, "#" included, which
# would turn a number into a string and silently break the limit (Number()
# returns NaN, which disables it instead of applying it).

# Still-image export cap; video/MP4 always renders at 1x regardless.
MAX_CANVAS_MPIX=16
# Seconds of output video.
MAX_RENDER_DURATION=120
MAX_RENDER_FPS=30
MAX_RENDER_FRAMES=3600
MAX_RENDER_ITEMS=20
MAX_TMP_BYTES=5368709120
# Parallel Puppeteer+FFmpeg jobs.
MAX_RENDER_CONCURRENCY=1
MAX_RENDER_QUEUE=4
# Per-job hard timeout, 15 min.
RENDER_TIMEOUT_MS=900000
# Parallel Puppeteer pages WITHIN one job.
RENDER_CONCURRENCY=2
# Captured frames of the animated keyframe span; raise if long animations
# get cut short.
MAX_ANIMATED_FRAMES=600
# Keep (FFMPEG_THREADS x MAX_RENDER_CONCURRENCY) at or below the host's
# vCPU count.
FFMPEG_THREADS=2

# Note: PUPPETEER_EXECUTABLE_PATH, PUPPETEER_NO_SANDBOX and RENDERER_URL are
# already configured correctly inside the image — no need to set them here.
