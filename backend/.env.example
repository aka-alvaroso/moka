# ── Server ───────────────────────────────────────────────────────────────────
# Port the backend listens on
PORT=4003

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed CORS origin — set to your frontend domain in production
ALLOWED_ORIGIN=https://alvaroso.dev

# ── Render authentication (REQUIRED in production) ───────────────────────────
# Callers must send "Authorization: Bearer <token>" on every POST /api/render
# request. Without this, render endpoints are open to anyone on the network.
# Generate a strong token with: openssl rand -hex 32
#
# Note: the frontend does NOT send this token — it is intended for
# server-to-server or direct API access control. For a fully public-facing
# deployment, protect the entire service at the proxy level (Caddy basic_auth,
# IP allowlist, etc.) in addition to setting this token.
RENDER_TOKEN=

# ── Puppeteer sandbox ─────────────────────────────────────────────────────────
# The Chrome sandbox is ACTIVE by default (safest posture).
# Set to 'true' ONLY when Chrome cannot initialise its sandbox — typically when
# the process runs as root inside a Docker/container environment.
# Never disable the sandbox on a host where unprivileged user namespaces work.
PUPPETEER_NO_SANDBOX=false

# ── Optional limits (safe defaults shown) ────────────────────────────────────
# MAX_CANVAS_MPIX=16
# MAX_RENDER_DURATION=300
# MAX_RENDER_FPS=60
# MAX_RENDER_FRAMES=3600
# MAX_RENDER_ITEMS=20
# MAX_TMP_BYTES=5368709120
# MAX_RENDER_CONCURRENCY=2
# MAX_RENDER_QUEUE=4
# RENDER_TIMEOUT_MS=300000
# RENDER_CONCURRENCY=2

# ── Puppeteer / renderer ──────────────────────────────────────────────────────
# PUPPETEER_EXECUTABLE_PATH=   # path to a system Chrome/Chromium binary
# RENDERER_URL=http://localhost:5173  # URL Puppeteer loads for frame capture
#   IMPORTANT: this must be the same origin as the backend serves in production
#   to stay within the Content Security Policy. In production, leave unset so
#   Puppeteer hits the Express static server directly (http://localhost:<PORT>).
